{
  "name": "@coderdojo/locker",
  "version": "0.1.0",
  "description": "Command line access to a CoderDojo Locker: upload, download, and manage projects with the code from your card.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "locker": "dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "coderdojo",
    "locker",
    "cli"
  ]
}
